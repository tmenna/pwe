# ============================================================
# PWE Portal — Environment Variables
# Copy this file to .env for local development.
# All variables marked (required) must be set in production.
# ============================================================

# --- Database -----------------------------------------------------------
# PostgreSQL connection string (required in production)
DATABASE_URL=postgresql://user:password@localhost:5432/pwe

# --- Session ------------------------------------------------------------
# Random secret for signing session cookies (required in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Cloudflare R2 Storage ---------------------------------------------
# Leave blank in development to use local disk uploads.
# Set all four values in production to enable R2.
#
# R2 endpoint format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: public CDN URL for your R2 bucket (avoids signed URLs)
# e.g. https://files.yourpwedomain.org
R2_PUBLIC_URL=

# --- Resend Email -------------------------------------------------------
# Leave blank to disable email (app still works without it).
RESEND_API_KEY=
# Sender address — must be a verified domain in Resend
# Example: "PWE Portal <noreply@pwe.org>"
FROM_EMAIL=PWE Portal <noreply@pwe.org>
# Your app's public URL (used in email links)
# Example: https://pwe.onrender.com
APP_URL=

# --- Upload Settings ----------------------------------------------------
# Maximum file size in MB (default: 20)
MAX_UPLOAD_SIZE_MB=20
# Local uploads directory (dev only — ignored when R2 is configured)
UPLOADS_DIR=./uploads

# --- Background Jobs ----------------------------------------------------
# Maximum concurrent background jobs (default: 5)
JOB_CONCURRENCY=5

# --- Node Environment ---------------------------------------------------
NODE_ENV=development
